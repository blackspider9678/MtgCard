{
  "schemaVersion": 1,
  "id": "mtgcard",
  "version": "${version}",
  "name": "MtgCard",
  "description": "satisfactory oreposits in the world of minecraft",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/mtgcard/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "com.spider.mtgcard.client.MtgcardClient"
    ],
    "jei_mod_plugin": [
      "com.spider.mtgcard.client.compat.jei.MtgcardJeiPlugin"
    ],
    "main": [
      "com.spider.mtgcard.Mtgcard"
    ]
  },
  "mixins": [
    "mtgcard.mixins.json",
    "mtgcard.mousetweaks.mixins.json",
    "mtgcard.flashback.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "${fabric_api_version_range}",
    "minecraft": "${minecraft_version_range}"
  }
}
